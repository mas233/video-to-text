# Video Summary - Agent 模式 Docker 镜像
# 使用 Python 3.11 基础镜像
FROM python:3.11-slim

# ─────────────────────────────────────────────────────────
# 构建参数: Whisper 模型选择
# 与 whisper_parser.py 中 select_model_by_resources() 逻辑对应:
#   large-v3-turbo  ← 默认推荐，内存 >= 8GB
#   medium          ← 内存 >= 4GB
#   small           ← 内存不足 4GB
# 构建时通过 --build-arg 覆盖，例如:
#   docker build --build-arg WHISPER_MODEL_SIZE=medium .
ARG WHISPER_MODEL_SIZE=large-v3-turbo

# ─────────────────────────────────────────────────────────

# 设置工作目录
WORKDIR /app

# 安装系统依赖
# - ffmpeg: 视频/音频处理
# - git: 克隆模型仓库
RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 创建必要的目录
RUN mkdir -p /app/models /app/data /app/output

# 复制应用代码
COPY core/ /app/core/
COPY agent/ /app/agent/
COPY mcp/ /app/mcp/

# 设置模型缓存目录环境变量
ENV TRANSFORMERS_CACHE=/app/models
ENV HF_HOME=/app/models
ENV MODELSCOPE_CACHE=/app/models

# ─────────────────────────────────────────────────────────
# 将构建参数转为运行时环境变量，供 whisper_parser.py 读取
# 应用层通过 os.getenv("WHISPER_MODEL_SIZE") 可覆盖自动选择逻辑
ENV WHISPER_MODEL_SIZE=${WHISPER_MODEL_SIZE}

# 根据构建参数预下载对应的 Whisper 模型（通过 ModelScope 镜像源）
# 映射关系与 whisper_parser.py _get_modelscope_id() 保持一致
RUN python - <<'PYEOF'
import os, sys
sys.path.insert(0, '/app')

size  = os.getenv("WHISPER_MODEL_SIZE", "large-v3-turbo")
model_map = {
    "large-v3-turbo": ("openai/whisper-large-v3-turbo", "AI-ModelScope/whisper-large-v3-turbo"),
    "large-v3":       ("openai/whisper-large-v3",       "AI-ModelScope/whisper-large-v3"),
    "medium":         ("openai/whisper-medium",         "AI-ModelScope/whisper-medium"),
    "small":          ("openai/whisper-small",          "AI-ModelScope/whisper-small"),
}
hf_id, ms_id = model_map.get(size, model_map["large-v3-turbo"])
cache_dir = os.getenv("TRANSFORMERS_CACHE", "/app/models")

print(f"[Dockerfile] Whisper 模型规格: {size}")
print(f"[Dockerfile] 尝试从 ModelScope 下载: {ms_id}")

# 优先 ModelScope，失败则回落到 HuggingFace
try:
    from modelscope.hub.snapshot_download import snapshot_download
    model_dir = snapshot_download(ms_id, cache_dir=cache_dir)
    print(f"[Dockerfile] ModelScope 下载完成: {model_dir}")
except Exception as e:
    print(f"[Dockerfile] ModelScope 失败 ({e})，回落至 HuggingFace: {hf_id}")
    from transformers import AutoModelForSpeechSeq2Seq, AutoProcessor
    AutoProcessor.from_pretrained(hf_id, cache_dir=cache_dir)
    AutoModelForSpeechSeq2Seq.from_pretrained(
        hf_id, cache_dir=cache_dir,
        low_cpu_mem_usage=True, use_safetensors=True
    )
    print(f"[Dockerfile] HuggingFace 下载完成: {hf_id}")
PYEOF
# ─────────────────────────────────────────────────────────

# 工作目录
WORKDIR /app

# 默认命令：交互模式
# 用户可以覆盖此命令
CMD ["python", "agent/video_agent.py", "--interactive"]
